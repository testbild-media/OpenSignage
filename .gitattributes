# LF everywhere: Windows autocrlf once broke every installer shebang (bash\r).
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
